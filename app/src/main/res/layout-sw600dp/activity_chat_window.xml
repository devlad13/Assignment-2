<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Chat messages on the left -->
    <ListView
        android:id="@+id/chatListView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/messageDetailsContainer"
        android:layout_above="@id/messageInput"
        android:dividerHeight="8dp" />

    <!-- Message input below the ListView -->
    <EditText
        android:id="@+id/messageInput"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@id/sendButton"
        android:hint="@string/message_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="3" />

    <!-- Send button aligned with the left chat panel -->
    <Button
        android:id="@+id/sendButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/messageInput"
        android:text="@string/send" />

    <!-- Fragment container on the right -->
    <FrameLayout
        android:id="@+id/messageDetailsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@id/chatListView"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="16dp" />

</RelativeLayout>
